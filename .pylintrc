[MASTER]
init-hook='import sys; sys.path.append("src")'
ignore=migrations,settings.py
load-plugins=pylint_django

[TYPECHECK]
ignored-classes=Role,UserRole,OTP,User
generated-members=objects,DoesNotExist
ignore-mixin-members=yes

[MESSAGES CONTROL]
disable=
    missing-docstring,
    wrong-import-order,
    too-few-public-methods,
    invalid-name,
    no-member,
    useless-super-delegation,
    too-many-ancestors,
    unused-import,
    ungrouped-imports,
    broad-exception-caught,
    too-many-arguments

[FORMAT]
max-line-length=120
